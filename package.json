{
  "name": "boladoc-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Boladoc Academy — AAP/CDC/JAMA pediatriya yangiliklarini o'zbek tilida Telegram kanalga avtomatik chiqaruvchi bot",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "draft": "node --env-file-if-exists=.env src/build-draft.js",
    "publish": "node --env-file-if-exists=.env src/publish.js",
    "approvals": "node --env-file-if-exists=.env src/check-approvals.js",
    "test": "node src/selftest.js",
    "check": "node --env-file-if-exists=.env src/setup-check.js",
    "preview": "node --env-file-if-exists=.env src/preview.js",
    "test:feeds": "node --env-file-if-exists=.env src/build-draft.js --dry-run"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "fast-xml-parser": "^4.5.0"
  }
}
